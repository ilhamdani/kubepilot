{
  "name": "kubepilot",
  "productName": "KubePilot",
  "version": "0.1.0",
  "description": "KubePilot — an open-source Kubernetes IDE for the desktop",
  "main": "./out/main/index.js",
  "author": "KubePilot contributors",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/kubepilot/kubepilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/kubepilot/kubepilot.git"
  },
  "bugs": {
    "url": "https://github.com/kubepilot/kubepilot/issues"
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "ide",
    "electron",
    "kubectl",
    "cluster",
    "devops",
    "open-source"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node tools/make-icon.js",
    "icon:icns": "node tools/make-icns.mjs",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "verify:mac": "node tools/verify-mac-config.mjs",
    "verify:features": "node --experimental-strip-types tools/verify-features.mjs",
    "verify:live-ui": "node tools/verify-live-ui.mjs",
    "site": "node tools/serve.mjs 4173 site"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
