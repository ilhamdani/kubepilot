<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript to machine code at runtime, and the Monaco
         editor leans on it hard. Without this the renderer dies on launch
         under hardened runtime, especially on Apple Silicon. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- V8 also allocates writable-then-executable pages (WebAssembly, and the
         code cache used by the preload bundle). Electron ships this entitlement
         in its own distribution for the same reason. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Electron re-launches its helper processes (GPU, renderer, utility) with
         DYLD_* variables pointing at the bundled framework. Hardened runtime
         strips those from the environment unless the app opts in, which breaks
         the helper processes on launch. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
